# Token independente, exclusivo do endpoint de sincronização agendada.
SYNC_JOB_TOKEN=

# Conexões canônicas opcionais no arquivo local.
WOO_SACRED_KEY=
WOO_SACRED_SECRET=
WOO_MAYA_KEY=
WOO_MAYA_SECRET=
WOO_SC23_KEY=
WOO_SC23_SECRET=
# Desenvolvimento também aceita <PREFIXO>_SITE_URL, <PREFIXO>_CONSUMER_KEY
# e <PREFIXO>_CONSUMER_SECRET; associação por hostname exato.
# Acesso ao site (o navegador solicita usuário e senha).
APP_AUTH_USER=
APP_AUTH_PASSWORD=

## API de consulta independente para bots; token aleatório de ao menos 32 caracteres.
BOT_API_TOKEN=

# Conector WhatsApp Cloud API (Meta). Envio desativado até configuração.
WHATSAPP_PROVIDER=meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_SEND_ENABLED=false
WHATSAPP_JOB_TOKEN=

# Utilizados apenas pelos scripts locais de relay/processamento.
WHATSAPP_BACKEND_ORIGIN=http://localhost:3000
WHATSAPP_RELAY_PORT=8788

# Banco do aplicativo (nunca NEXT_PUBLIC_).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
